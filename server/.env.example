NODE_ENV=development
PORT=3000

# MongoDB (local install)
MONGODB_URI=mongodb://127.0.0.1:27017/firewatch69

# JWT (access token only in Phase 1)
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=1h

# CORS: comma-separated list of allowed web origins (leave empty to allow all in dev)
WEB_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Seed admin (used only by `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@firewatch69.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Admin
